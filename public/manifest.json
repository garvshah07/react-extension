{
  "manifest_version": 3,
  "name": "AgreeWise",
  "version": "1.0.0",
  "description": "A browser extension that scans policy and document text, then highlights the most important risks and key points in a clear, easy-to-review summary.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://api.groq.com/*"]
}
